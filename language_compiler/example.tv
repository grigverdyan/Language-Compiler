# Function that adds two integers
def add(a: int, b: int): int {
    return a + b;
}

# The main function
def main(): int {
    let x: int = 5;
    let y: int = 10;
    let result: int = add(x, y);

    if (result > 10)
    {
        result = result + 10;
    }
    elif (result == 0)
    {
        result = 42;
    }
    else 
    { 
        result = 1;
    }

    while (result > 0)
    {
        
        result = result - 1;
    }
    return 0;
}