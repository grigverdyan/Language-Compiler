# Function that adds two integers
def add(a: int, b: int): int {
    return a + b;
}

# The main function
def main(): void {
    let x: int = 5;
    let y: int = 10;
    let result: int = add(x, y);

    if (result > 10)
    {
        result = result + 10;
    }

    while (result > 0)
    {
        # print(result);
        result = result - 1;
    }
}